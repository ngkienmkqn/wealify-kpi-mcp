# Base URL of the KPI Dashboard API (no trailing slash).
# Prod: https://kpi.wealify.com/api/v1
KPI_BASE_URL=https://kpi.wealify.com/api/v1

# Read-only service token. MUST equal the dashboard backend's PAPERCLIP_READ_TOKEN.
# Generate with: openssl rand -hex 32
PAPERCLIP_READ_TOKEN=replace-with-the-read-only-token
